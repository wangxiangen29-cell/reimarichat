# ===== 红白与黑白 · 茶话会 环境变量 =====
# 复制本文件为 .env（或直接按平台变量导入），填入真实值。
# 注意：.env 已被 .gitignore 忽略，不要提交真实密钥到仓库。
# API Key（必填，OpenCode Go）
DEEPSEEK_API_KEY=sk-你的Key
# 管理员口令（建议填写；不填则每次重启随机生成）
ADMIN_TOKEN=请改成你的管理员口令
# 模型名
DEEPSEEK_MODEL=deepseek-v4-flash
# 接口地址（OpenCode Go，兼容 OpenAI 格式）
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# 内置 AI 总开关
AI_ENABLED=true
# 自动闲聊开关（建议先 false，确认正常再 true）
AUTO_CHAT_ENABLED=false
# 一设资料总开关
CANON_ENABLED=true
# 一设按需注入（省 token）
CANON_SMART=true
# 每个访客每分钟 AI 调用上限
RATE_LIMIT_PER_MIN=20
# 自动闲聊每次批量生成句数（2~24）
AUTO_BATCH_SIZE=24
# 思考模式：none / low / high / max
THINKING_MODE=none
